# Copy this file to `.env` when you want to run the containerised dev loop.
#
# Required by the `web-dev` Compose service: Metro advertises bundle URLs using this
# host, so unset inside a container it advertises the container IP and the host browser
# cannot load the bundle.
#
# Fill it in with this machine's LAN IPv4:
#
#   hostname -I | awk '{print $1}'
#
# The value is machine-specific, so it is deliberately empty here and never committed —
# `.env` is gitignored, `.env.example` is not. Compose fails fast with
# "set HOST_IP to your LAN IP" rather than starting a dev server the browser cannot use.
HOST_IP=
