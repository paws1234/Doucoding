# Local VS Code / Copilot prompt files — this machine only, never published.
# Scoped to prompts/ on purpose: .github/workflows/ and templates stay usable.
.github/prompts/

# Node / Expo
node_modules/
dist/
.expo/
*.log

# Env files — never commit real values. `.env.example` is tracked on purpose.
.env
.env.*
!.env.example

# Generated Android build output, and signing material that must never be committed
android/
*.apk
*.keystore
*.jks
