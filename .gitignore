# Local VS Code / Copilot prompt files — this machine only, never published.
# Scoped to prompts/ on purpose: .github/workflows/ and templates stay usable.
.github/prompts/

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# logs
*.log

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit real values. `.env.example` is tracked on purpose.
.env
.env.*
.env*.local
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# built artifacts and signing material that must never be committed
*.apk
*.keystore
